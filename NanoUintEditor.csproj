<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>NanoUintEditor</RootNamespace>
    <AssemblyName>NanoUintEditor</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>EditerLogo.ico</ApplicationIcon>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NanoUint\NanoUint2D\NanoUint2D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives under this folder; keep its sources out of this project's glob. -->
    <Compile Remove="NanoUintEditor.Tests\**" />
    <None Remove="NanoUintEditor.Tests\**" />
  </ItemGroup>

</Project>
